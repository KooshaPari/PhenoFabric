{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Phenotype Fabric",
  "identifier": "com.phenotype.fabric",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Phenotype Fabric",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Phenotype Fabric — network fabric management GUI",
    "longDescription": "Phenotype Fabric desktop application for managing network topology, routes, leases, streaming, and daemon lifecycle.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-dev", "libappindicator3-dev"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
