{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phenotype.dev/schemas/wire-protocol-v1.json",
  "title": "Phenotype Fabric Wire Protocol",
  "description": "JSON wire protocol for fabric-daemon client-server communication.",
  "$defs": {
    "topology_node": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "locality": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "topology_edge": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "edge_type": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "node_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topology_node"
      }
    },
    "edge_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topology_edge"
      }
    },
    "route_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "capability_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "oneOf": [
    {
      "$comment": "heartbeat: keepalive ping from client",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heartbeat",
            "Heartbeat"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "health_check: request daemon health status",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "health_check",
            "HealthCheck"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "topology_request: request current topology",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "topology_request",
            "TopologyRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "routes_request: request compiled routes/plans",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "routes_request",
            "RoutesRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "capabilities_request: request node capabilities",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "capabilities_request",
            "CapabilitiesRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "probe_request: request topology snapshot",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "probe_request",
            "ProbeRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "compile_request: compile a multihop route",
      "type": "object",
      "required": [
        "type",
        "source",
        "destination"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "compile_request",
            "CompileRequest"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "intent_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "webrtc_offer: WebRTC SDP offer from client",
      "type": "object",
      "required": [
        "type",
        "target",
        "sdp"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "webrtc_offer",
            "WebRTCOffer"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sdp": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "webrtc_answer: WebRTC SDP answer from client",
      "type": "object",
      "required": [
        "type",
        "target",
        "sdp"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "webrtc_answer",
            "WebRTCAnswer"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sdp": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "webrtc_ice: ICE candidate relay",
      "type": "object",
      "required": [
        "type",
        "from",
        "candidate"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "webrtc_ice",
            "WebRTCIce"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_start: begin WorkOS AuthKit login, returns authorize URL + state + PKCE challenge",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_start",
            "AuthStart"
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_complete: exchange the authorization code for tokens (PKCE)",
      "type": "object",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_complete",
            "AuthComplete"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string"
        },
        "code_verifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_email: start passwordless magic-link login for an email address",
      "type": "object",
      "required": [
        "type",
        "email"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_email",
            "AuthEmail"
          ]
        },
        "email": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_status: report current login state (AuthStatus contract fields)",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_status",
            "AuthStatus"
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_verify: verify a Magic Auth code and complete passwordless login",
      "type": "object",
      "required": [
        "type",
        "email",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_verify",
            "AuthVerify"
          ]
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_logout: clear the stored session (sign out)",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_logout",
            "AuthLogout"
          ]
        }
      },
      "additionalProperties": true
    }
  ]
}
