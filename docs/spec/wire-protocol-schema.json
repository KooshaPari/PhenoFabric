{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phenotype.dev/schemas/wire-protocol-v1.json",
  "title": "Phenotype Fabric Wire Protocol",
  "description": "JSON wire protocol for fabric-daemon client-server communication.",
  "$defs": {
    "topology_node": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "locality": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "topology_edge": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "edge_type": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "node_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topology_node"
      }
    },
    "edge_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topology_edge"
      }
    },
    "route_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "capability_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "oneOf": [
    {
      "$comment": "heartbeat: keepalive ping from client",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heartbeat",
            "Heartbeat"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "health_check: request daemon health status",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "health_check",
            "HealthCheck"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "topology_request: request current topology",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "topology_request",
            "TopologyRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "routes_request: request compiled routes/plans",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "routes_request",
            "RoutesRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "capabilities_request: request node capabilities",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "capabilities_request",
            "CapabilitiesRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "probe_request: request topology snapshot",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "probe_request",
            "ProbeRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "compile_request: compile a multihop route",
      "type": "object",
      "required": [
        "type",
        "source",
        "destination"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "compile_request",
            "CompileRequest"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "intent_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "webrtc_offer: WebRTC SDP offer from client",
      "type": "object",
      "required": [
        "type",
        "target",
        "sdp"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "webrtc_offer",
            "WebRTCOffer"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sdp": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "webrtc_answer: WebRTC SDP answer from client",
      "type": "object",
      "required": [
        "type",
        "target",
        "sdp"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "webrtc_answer",
            "WebRTCAnswer"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sdp": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "webrtc_ice: ICE candidate relay",
      "type": "object",
      "required": [
        "type",
        "from",
        "candidate"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "webrtc_ice",
            "WebRTCIce"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "session_close: orderly end of a frame session; removes it from the daemon",
      "type": "object",
      "required": [
        "type",
        "session_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_close",
            "SessionClose"
          ]
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Server-assigned session id from a prior session_ack."
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "session_cancel: abort a frame session mid-transfer; removes it from the daemon",
      "type": "object",
      "required": [
        "type",
        "session_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_cancel",
            "SessionCancel"
          ]
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Server-assigned session id from a prior session_ack."
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "session_resume: continue a frame session after a client disconnect. Requires no credential beyond the same server-assigned session_id that session_init already issued, which is the same proof session_close and session_cancel accept.",
      "type": "object",
      "required": [
        "type",
        "session_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_resume",
            "SessionResume"
          ]
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Server-assigned session id from a prior session_ack. The session must still be live: a closed, cancelled, or expired session is refused with session_gone."
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "network_status_request: probe UPnP, STUN, and Tailscale availability on the daemon host",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "network_status_request",
            "NetworkStatusRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "network_stun_request: perform a STUN binding request and return the observed external address",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "network_stun_request",
            "NetworkStunRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "network_tailscale_request: report local Tailscale node status and tailnet peers",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "network_tailscale_request",
            "NetworkTailscaleRequest"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "surface_lease_request: create a surface lease in the Pending state (binding happens at route-planning time)",
      "type": "object",
      "required": [
        "type",
        "name",
        "protocol",
        "locality_floor"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "surface_lease_request",
            "SurfaceLeaseRequest"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "locality_floor": {
          "type": "string",
          "minLength": 1
        },
        "requires_rt": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    {
      "$comment": "auth_start: begin WorkOS AuthKit login, returns authorize URL + state + PKCE challenge",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_start",
            "AuthStart"
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_complete: exchange the authorization code for tokens (PKCE)",
      "type": "object",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_complete",
            "AuthComplete"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string"
        },
        "code_verifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_email: start passwordless magic-link login for an email address",
      "type": "object",
      "required": [
        "type",
        "email"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_email",
            "AuthEmail"
          ]
        },
        "email": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_status: report current login state (AuthStatus contract fields)",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_status",
            "AuthStatus"
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_verify: verify a Magic Auth code and complete passwordless login",
      "type": "object",
      "required": [
        "type",
        "email",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_verify",
            "AuthVerify"
          ]
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "auth_logout: clear the stored session (sign out)",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth_logout",
            "AuthLogout"
          ]
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "session_init: open a frame-streaming session. Fields mirror fabric_frame_transport::SessionInit; the daemon replies with session_ack carrying the server-assigned session_id.",
      "type": "object",
      "required": [
        "type",
        "client_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_init",
            "SessionInit"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "preferred_codec": {
          "type": "string",
          "enum": [
            "Hevc",
            "Av1",
            "Nv12",
            "Rgba"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "target_fps": {
          "type": "integer",
          "minimum": 1
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "frame_data: deliver one frame for an established session. Fields mirror fabric_frame_transport::FrameHeader; session_id is the id from session_ack. A frame for an unknown session returns frame_error with error=unknown_session.",
      "type": "object",
      "required": [
        "type",
        "seq"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "frame_data",
            "FrameData"
          ]
        },
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "pts_us": {
          "type": "integer",
          "minimum": 0
        },
        "dts_us": {
          "type": "integer",
          "minimum": 0
        },
        "is_keyframe": {
          "type": "boolean"
        },
        "codec": {
          "type": "string",
          "enum": [
            "Hevc",
            "Av1",
            "Nv12",
            "Rgba"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "payload_len": {
          "type": "integer",
          "minimum": 0
        },
        "duration_us": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    {
      "$comment": "frame_ack: acknowledge a received frame. Fields mirror fabric_frame_transport::FrameAck. The daemon replies with frame_ack_response, whose acked field is true only when it had received a frame at or past seq.",
      "type": "object",
      "required": [
        "type",
        "seq"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "frame_ack",
            "FrameAck"
          ]
        },
        "session_id": {
          "type": "integer",
          "minimum": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "rtt_us": {
          "type": "integer",
          "minimum": 0
        },
        "recv_pts_us": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  ]
}
